          ],
          "default": null,
          "title": "Source Label"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "BlocoTabela",
      "type": "object"
    },
    "ColunaTabela": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "type": {
          "default": "text",
          "enum": [
            "number",
            "currency",
            "percent",
            "text"
          ],
          "title": "Type",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        }
      },
      "required": [
        "key",
        "label"
      ],
      "title": "ColunaTabela",
      "type": "object"
    },
    "EventoBlocoPronto": {
      "additionalProperties": false,
      "description": "Entrega bloco completo validado pelo contrato, inclusive HTML opaco da API de dados.\n\nPara `api_html`, a valida\u00e7\u00e3o cobre somente o envelope e a presen\u00e7a do conte\u00fado;\na string n\u00e3o passa pela valida\u00e7\u00e3o sem\u00e2ntica/reconstru\u00e7\u00e3o reservada \u00e0 sa\u00edda LLM.",
      "properties": {
        "solicitacao_id": {
          "format": "uuid",
          "title": "Solicitacao Id",
          "type": "string"
        },
        "conversa_id": {
          "format": "uuid",
          "title": "Conversa Id",
          "type": "string"
        },
        "mensagem_id": {
          "format": "uuid",
          "title": "Mensagem Id",
          "type": "string"
        },
        "sequencia": {
          "minimum": 0,
          "title": "Sequencia",
          "type": "integer"
        },
        "tipo": {
          "const": "bloco.pronto",
          "title": "Tipo",
          "type": "string"
        },
        "bloco": {
          "discriminator": {
            "mapping": {
              "api_html": "#/$defs/BlocoHtmlApiDados",
              "chart": "#/$defs/BlocoGrafico",
              "html": "#/$defs/BlocoHtmlVisual",
              "kpi": "#/$defs/BlocoKPI",
              "kpi_group": "#/$defs/GrupoKPIs",
              "table": "#/$defs/BlocoTabela"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BlocoKPI"
            },
            {
              "$ref": "#/$defs/GrupoKPIs"
            },
            {
              "$ref": "#/$defs/BlocoTabela"
            },
            {
              "$ref": "#/$defs/BlocoGrafico"
            },
            {
              "$ref": "#/$defs/BlocoHtmlVisual"
            },
            {
              "$ref": "#/$defs/BlocoHtmlApiDados"
            }
          ],
          "title": "Bloco"
        }
      },
      "required": [
        "solicitacao_id",
        "conversa_id",
        "mensagem_id",
        "sequencia",
        "tipo",
        "bloco"
      ],
      "title": "EventoBlocoPronto",
      "type": "object"
    },
