{
  "$defs": {
    "BlocoGrafico": {
      "additionalProperties": false,
      "description": "Contrato dos gr\u00e1ficos e das cores fornecidas pela fonte anal\u00edtica.\n\nCores de categoria s\u00e3o indexadas pelo r\u00f3tulo do eixo X para manter a mesma\ncor quando a ordena\u00e7\u00e3o dos dados mudar. O Frontend fornece uma paleta padr\u00e3o\npara categorias e s\u00e9ries sem cor expl\u00edcita.",
      "properties": {
        "type": {
          "const": "chart",
          "default": "chart",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "chart_type": {
          "enum": [
            "line",
            "bar",
            "pie"
          ],
          "title": "Chart Type",
          "type": "string"
        },
        "x": {
          "minLength": 1,
          "title": "X",
          "type": "string"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/SerieGrafico"
          },
          "minItems": 1,
          "title": "Series",
          "type": "array"
        },
        "data": {
          "items": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object"
          },
          "minItems": 1,
          "title": "Data",
          "type": "array"
        },
        "summary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "category_colors": {
          "anyOf": [
            {
              "additionalProperties": {
                "pattern": "^#[0-9A-Fa-f]{6}$",
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category Colors"
        }
      },
      "required": [
        "title",
        "chart_type",
        "x",
        "series",
        "data"
      ],
      "title": "BlocoGrafico",
      "type": "object"
    },
    "BlocoHtmlApiDados": {
      "additionalProperties": false,
      "description": "HTML original da API de dados, mantido separado das visualiza\u00e7\u00f5es da LLM.\n\nO Backend valida somente o envelope do contrato. O corpo permanece como foi\nrecebido e deve ser exibido pelo Frontend em um documento isolado, sem passar\npelo validador que reconstr\u00f3i o HTML est\u00e1tico produzido pela LLM.",
      "properties": {
        "type": {
          "const": "api_html",
          "default": "api_html",
          "title": "Type",
          "type": "string"
        },
        "html": {
          "minLength": 1,
          "title": "Html",
          "type": "string"
        }
      },
      "required": [
        "html"
      ],
      "title": "BlocoHtmlApiDados",
      "type": "object"
    },
    "BlocoHtmlVisual": {
      "additionalProperties": false,
      "description": "Visualiza\u00e7\u00e3o est\u00e1tica versionada para KPIs e gr\u00e1ficos fora do cat\u00e1logo v1.\n\nO Gateway recebe HTML do servi\u00e7o da Iara, mas s\u00f3 persiste a vers\u00e3o reconstru\u00edda\npela allowlist. Um resumo textual obrigat\u00f3rio permite compreender a figura sem\ndepender do iframe visual.",
      "properties": {
        "type": {
          "const": "html",
          "default": "html",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "html": {
          "maxLength": 32768,
          "minLength": 1,
          "title": "Html",
          "type": "string"
        }
      },
      "required": [
        "title",
        "summary",
        "html"
      ],
      "title": "BlocoHtmlVisual",
      "type": "object"
    },
    "BlocoKPI": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "kpi",
          "default": "kpi",
          "title": "Type",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "format": {
          "default": "number",
          "enum": [
            "number",
            "currency",
            "percent",
            "text"
          ],
          "title": "Format",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "change": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change"
        },
        "period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "BlocoKPI",
      "type": "object"
    },
    "BlocoTabela": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "table",
          "default": "table",
          "title": "Type",
