{
  "$defs": {
    "BlocoCodigo": {
      "additionalProperties": false,
      "description": "Trecho de código legado exibido sem interpretação ou execução no Frontend.\n\nO fluxo atual não detecta nem move código para este bloco. O contrato permanece\npara compatibilidade com mensagens existentes e usa o limite geral da mensagem.",
      "properties": {
        "code": {
          "maxLength": 524288,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "language": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_+#.-]{1,32}$",
          "title": "Language",
          "type": "string"
        },
        "type": {
          "const": "code",
          "default": "code",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "language",
        "code"
      ],
      "title": "BlocoCodigo",
      "type": "object"
    },
    "BlocoErro": {
      "additionalProperties": false,
      "description": "Falha pública estável que pode encerrar uma mensagem da assistente.",
      "properties": {
        "code": {
          "enum": [
            "unauthenticated",
            "forbidden",
            "not_found",
            "validation_error",
            "rate_limited",
            "source_unavailable",
            "model_unavailable",
            "timeout",
            "internal_error"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "BlocoErro",
      "type": "object"
    },
    "BlocoGrafico": {
      "additionalProperties": false,
      "description": "Contrato dos gráficos e das cores fornecidas pela fonte analítica.\n\nCores de categoria são indexadas pelo rótulo do eixo X para manter a mesma\ncor quando a ordenação dos dados mudar. O Frontend fornece uma paleta padrão\npara categorias e séries sem cor explícita.",
      "properties": {
        "category_colors": {
          "anyOf": [
            {
              "additionalProperties": {
                "pattern": "^#[0-9A-Fa-f]{6}$",
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category Colors"
        },
        "chart_type": {
          "enum": [
            "line",
            "bar",
            "pie"
          ],
          "title": "Chart Type",
          "type": "string"
        },
        "data": {
          "items": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object"
          },
          "minItems": 1,
          "title": "Data",
          "type": "array"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/SerieGrafico"
          },
          "minItems": 1,
          "title": "Series",
          "type": "array"
        },
        "summary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "type": {
          "const": "chart",
          "default": "chart",
          "title": "Type",
          "type": "string"
        },
        "x": {
          "minLength": 1,
          "title": "X",
          "type": "string"
        }
      },
      "required": [
        "title",
        "chart_type",
        "x",
        "series",
        "data"
      ],
      "title": "BlocoGrafico",
      "type": "object"
    },
    "BlocoHtmlApiDados": {
      "additionalProperties": false,
      "description": "HTML original da API de dados, mantido separado das visualizações da LLM.\n\nO Backend valida somente o envelope do contrato. O corpo permanece como foi\nrecebido e deve ser exibido pelo Frontend em um documento isolado, sem passar\npelo validador que reconstrói o HTML estático produzido pela LLM.",
      "properties": {
        "html": {
          "title": "Html",
          "type": "string"
        },
        "type": {
          "const": "api_html",
          "default": "api_html",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "html"
      ],
      "title": "BlocoHtmlApiDados",
      "type": "object"
    },
    "BlocoHtmlVisual": {
      "additionalProperties": false,
      "description": "Bloco visual HTML legado, validado separadamente da carga opaca da API.\n\nO contrato continua disponível para compatibilidade histórica. A resposta\ntextual atual não é convertida para este bloco; `api_html` transporta o HTML\nmarcado por `iara-visuals` sem validação semântica ou reconstrução.",
      "properties": {
        "html": {
          "minLength": 1,
          "title": "Html",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "type": {
          "const": "html",
          "default": "html",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "title",
        "summary",
        "html"
      ],
      "title": "BlocoHtmlVisual",
      "type": "object"
    },
    "BlocoKPI": {
      "additionalProperties": false,
      "description": "Indicador legado tipado preservado para leitura do contrato público v1.",
      "properties": {
        "change": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "format": {
          "default": "number",
          "enum": [
            "number",
            "currency",
            "percent",
            "text"
          ],
          "title": "Format",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "type": {
          "const": "kpi",
          "default": "kpi",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "BlocoKPI",
      "type": "object"
    },
    "BlocoProcessando": {
      "additionalProperties": false,
      "description": "Estado transitório persistível enquanto uma solicitação está em andamento.",
      "properties": {
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "type": {
          "const": "processing",
          "default": "processing",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "BlocoProcessando",
      "type": "object"
    },
    "BlocoTabela": {
      "additionalProperties": false,
      "description": "Tabela cuja estrutura é validada antes de persistência ou publicação.",
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/ColunaTabela"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object"
          },
          "title": "Rows",
          "type": "array"
        },
        "source_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Label"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "type": {
          "const": "table",
          "default": "table",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "BlocoTabela",
      "type": "object"
    },
    "BlocoTexto": {
      "additionalProperties": false,
      "description": "Texto Markdown seguro exibido como parte de uma mensagem pública.",
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "text",
          "default": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "BlocoTexto",
      "type": "object"
    },
    "ColunaTabela": {
      "additionalProperties": false,
      "description": "Descreve chave, rótulo e formatação de uma coluna tabular.",
      "properties": {
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "type": {
          "default": "text",
          "enum": [
            "number",
            "currency",
            "percent",
            "text"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label"
      ],
      "title": "ColunaTabela",
      "type": "object"
    },
    "GrupoKPIs": {
      "additionalProperties": false,
      "description": "Agrupa indicadores relacionados sob um título opcional no contrato v1.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/BlocoKPI"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "type": {
          "const": "kpi_group",
          "default": "kpi_group",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "title": "GrupoKPIs",
      "type": "object"
    },
    "SerieGrafico": {
      "additionalProperties": false,
      "description": "Representa uma série e sua cor opcional validada no contrato público.\n\nO Backend valida as cores recebidas do serviço antes de persistir ou emitir o\nbloco. O Frontend usa seu token categórico quando ``cor`` não é informado.",
      "properties": {
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "format": {
          "default": "number",
          "enum": [
            "number",
            "currency",
            "percent"
          ],
          "title": "Format",
          "type": "string"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label"
      ],
      "title": "SerieGrafico",
      "type": "object"
    },
    "mensagem": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "user"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "items": {
                  "$ref": "#/$defs/BlocoTexto"
                },
                "maxItems": 1,
                "minItems": 1
              },
              "status": {
                "const": "completed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "processing"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "properties": {
                "content": {
                  "contains": {
                    "$ref": "#/$defs/BlocoErro"
                  }
                }
              }
            },
            "properties": {
              "content": {
                "contains": {
                  "$ref": "#/$defs/BlocoProcessando"
                },
                "maxContains": 1,
                "minContains": 1
              },
              "role": {
                "const": "assistant"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "properties": {
                "content": {
                  "contains": {
                    "$ref": "#/$defs/BlocoProcessando"
                  }
                }
              }
            },
            "properties": {
              "content": {
                "contains": {
                  "$ref": "#/$defs/BlocoErro"
                },
                "maxContains": 1,
                "minContains": 1
              },
              "role": {
                "const": "assistant"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "items": {
                  "not": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/BlocoErro"
                      },
                      {
                        "$ref": "#/$defs/BlocoProcessando"
                      }
                    ]
                  }
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "cancelled",
                  "incomplete"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "items": {
                  "not": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/BlocoErro"
                      },
                      {
                        "$ref": "#/$defs/BlocoProcessando"
                      }
                    ]
                  }
                }
              },
              "role": {
                "const": "assistant"
              }
            }
          }
        }
      ],
      "description": "Mensagem persistível; blocos HTML e de código exigem a versão 2.",
      "properties": {
        "content": {
          "items": {
            "discriminator": {
              "mapping": {
                "api_html": "#/$defs/BlocoHtmlApiDados",
                "chart": "#/$defs/BlocoGrafico",
                "code": "#/$defs/BlocoCodigo",
                "error": "#/$defs/BlocoErro",
                "html": "#/$defs/BlocoHtmlVisual",
                "kpi": "#/$defs/BlocoKPI",
                "kpi_group": "#/$defs/GrupoKPIs",
                "processing": "#/$defs/BlocoProcessando",
                "table": "#/$defs/BlocoTabela",
                "text": "#/$defs/BlocoTexto"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/BlocoTexto"
              },
              {
                "$ref": "#/$defs/BlocoCodigo"
              },
              {
                "$ref": "#/$defs/BlocoKPI"
              },
              {
                "$ref": "#/$defs/GrupoKPIs"
              },
              {
                "$ref": "#/$defs/BlocoTabela"
              },
              {
                "$ref": "#/$defs/BlocoGrafico"
              },
              {
                "$ref": "#/$defs/BlocoHtmlVisual"
              },
              {
                "$ref": "#/$defs/BlocoHtmlApiDados"
              },
              {
                "$ref": "#/$defs/BlocoErro"
              },
              {
                "$ref": "#/$defs/BlocoProcessando"
              }
            ]
          },
          "title": "Content",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "processing",
            "completed",
            "failed",
            "cancelled",
            "incomplete"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "role",
        "status",
        "created_at",
        "content"
      ],
      "title": "MensagemPublica",
      "type": "object"
    },
    "ErroHttp": {
      "additionalProperties": false,
      "description": "Representa o corpo interno do envelope de erro HTTP compartilhado.",
      "properties": {
        "code": {
          "enum": [
            "unauthenticated",
            "forbidden",
            "not_found",
            "validation_error",
            "rate_limited",
            "source_unavailable",
            "model_unavailable",
            "timeout",
            "internal_error"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ErroHttp",
      "type": "object"
    },
    "EnvelopeErro": {
      "additionalProperties": false,
      "description": "Envelope público usado por todas as respostas HTTP de falha.",
      "properties": {
        "error": {
          "$ref": "#/$defs/ErroHttp"
        }
      },
      "required": [
        "error"
      ],
      "title": "EnvelopeErro",
      "type": "object"
    }
  },
  "$ref": "#/$defs/mensagem",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
