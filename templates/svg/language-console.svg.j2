<!-- DSI GitHub Command Center | Autor: Dayvid Santana | Criado/Editado: 28/08/2026 | Objetivo: Renderizar o console animado de proficiência em linguagens. -->
{% set top_languages = languages_report.languages[:8] if languages_report else [] %}
{% set more_count = (languages_report.languages|length - 8) if languages_report and languages_report.languages|length > 8 else 0 %}
{% set row_height = 46 %}
{% set top_offset = 116 %}
{% set bottom_offset = 34 %}
{% set panel_height = (top_offset + top_languages|length * row_height + bottom_offset) if languages_report else 190 %}
<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="{{ panel_height }}" viewBox="0 0 1280 {{ panel_height }}" role="img" aria-labelledby="lc-title lc-desc">
  <title id="lc-title">DSI — Language Proficiency Console</title>
  <desc id="lc-desc">Proficiência em linguagens de programação calculada a partir dos repositórios públicos do operador.</desc>
  <defs>
    <pattern id="lc-grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" fill="none" stroke="{{ theme.grid }}" stroke-width="1" opacity=".5"/></pattern>
  </defs>
  <rect width="1280" height="{{ panel_height }}" fill="{{ theme.background }}"/>
  <rect width="1280" height="{{ panel_height }}" fill="url(#lc-grid)" opacity=".5"/>
  <rect x="1" y="1" width="1278" height="{{ panel_height - 2 }}" fill="none" stroke="{{ theme.border }}" stroke-width="2"/>
  {% if enable_animations %}
  <rect x="0" y="-26" width="1280" height="26" fill="{{ theme.primary }}" opacity=".07">
    <animate attributeName="y" values="-26;{{ panel_height }}" dur="8s" repeatCount="indefinite"/>
  </rect>
  {% endif %}
  <g font-family="Consolas, 'Courier New', monospace">
    <text x="40" y="48" font-size="20" font-weight="700" letter-spacing="2" fill="{{ theme.text }}">LANGUAGE PROFICIENCY</text>
    <text x="40" y="70" font-size="12" letter-spacing="2" fill="{{ theme.muted }}">{% if languages_report %}SOURCE CODE ANALYSIS // {{ languages_report.repository_count }} REPOSITORIES SCANNED{% else %}AWAITING DATA UPLINK{% endif %}{% if enable_animations %}<tspan fill="{{ theme.primary }}"><animate attributeName="opacity" values="1;0;1" dur="1s" repeatCount="indefinite"/>_</tspan>{% endif %}</text>
    {% if languages_report %}
    <circle cx="1152" cy="43" r="6" fill="{{ theme.success }}">{% if enable_animations %}<animate attributeName="opacity" values="1;.35;1" dur="2.8s" repeatCount="indefinite"/>{% endif %}</circle>
    <text x="1168" y="48" font-size="13" font-weight="700" letter-spacing="1" fill="{{ theme.primary }}">{{ languages_report.operator_title }}</text>
    {% endif %}
  </g>
  <path d="M40 90H1240" stroke="{{ theme.primary }}" stroke-width="1" opacity=".45"/>
  {% if languages_report %}
  <g font-family="Consolas, 'Courier New', monospace">
    {% for language in top_languages %}
    {% set row_y = top_offset + loop.index0 * row_height %}
    {% set rank_color = theme.success if language.rank_code == "OMEGA" else theme.primary if language.rank_code == "ALPHA" else theme.warning if language.rank_code == "BRAVO" else theme.secondary if language.rank_code == "CHARLIE" else theme.muted %}
    {% set fill_width = (500 * language.percentage / 100) | round(1) %}
    <g>
      <title>{{ language.name }} — {{ language.title }} ({{ language.repository_count }} repo{{ "s" if language.repository_count != 1 else "" }})</title>
      <text x="40" y="{{ row_y + 5 }}" font-size="15" font-weight="600" fill="{{ theme.text }}">{{ language.name }}</text>
      <rect x="380" y="{{ row_y - 7 }}" width="500" height="14" rx="3" fill="{{ theme.background_secondary }}" stroke="{{ theme.border }}" stroke-width="1"/>
      <rect x="380" y="{{ row_y - 7 }}" height="14" rx="3" fill="{{ rank_color }}" width="{{ fill_width if not enable_animations else 0 }}">
        {% if enable_animations %}<animate attributeName="width" from="0" to="{{ fill_width }}" dur="1s" begin="{{ (loop.index0 * 0.12) | round(2) }}s" fill="freeze"/>{% endif %}
      </rect>
      <text x="892" y="{{ row_y + 5 }}" font-size="13" fill="{{ theme.text }}">{{ language.percentage }}%</text>
      <rect x="950" y="{{ row_y - 8 }}" width="76" height="20" rx="3" fill="none" stroke="{{ rank_color }}" stroke-width="1.5"/>
      <text x="988" y="{{ row_y + 5 }}" font-size="11" letter-spacing="1" fill="{{ rank_color }}" text-anchor="middle">{{ language.rank_code }}</text>
    </g>
    {% endfor %}
  </g>
  {% if more_count > 0 %}
  <text x="40" y="{{ panel_height - 14 }}" font-family="Consolas, 'Courier New', monospace" font-size="11" letter-spacing="1" fill="{{ theme.muted }}">+{{ more_count }} ADDITIONAL LANGUAGE{{ "S" if more_count != 1 else "" }} LOGGED // FULL TELEMETRY: data/languages.json</text>
  {% endif %}
  {% else %}
  <text x="40" y="140" font-family="Consolas, 'Courier New', monospace" font-size="14" fill="{{ theme.muted }}">NO TELEMETRY RECEIVED. RUN <tspan fill="{{ theme.primary }}">dsi-profile fetch-languages</tspan> TO ESTABLISH UPLINK.</text>
  {% endif %}
</svg>
