<!-- DSI GitHub Command Center | Autor: Dayvid Santana | Criado/Editado: 28/08/2026 | Objetivo: Renderizar o console animado de telemetria de missão (GitHub). -->
{% set icon_commit = ["M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 2.5a4.5 4.5 0 0 1 4.473 4H14.5a.5.5 0 0 1 0 1h-2.027A4.5 4.5 0 0 1 8 12.5a4.5 4.5 0 0 1-4.473-4H1.5a.5.5 0 0 1 0-1h2.027A4.5 4.5 0 0 1 8 3.5zm0 1.5a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"] %}
{% set icon_star = ["M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25z"] %}
{% set icon_pr = ["M5 3.254V3.25v.005a.75.75 0 1 1 0-.005zm6.5 8a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5zM5 12.75a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5zm-1.5.75a1.5 1.5 0 1 0 1.5 1.5v-8.5a1.5 1.5 0 1 0-1.5-1.5v8.5a1.5 1.5 0 0 0 0 0zm8.5-2.5a1.5 1.5 0 0 0-1.5 1.5 1.5 1.5 0 1 0 3 0v-3.133l.025-.05A3.252 3.252 0 0 0 11 5.25V3.5h1.25a.75.75 0 0 0 .53-1.28l-2-2a.75.75 0 0 0-1.06 0l-2 2A.75.75 0 0 0 8.25 3.5H9.5v1.75a1.75 1.75 0 0 0 1.75 1.75h.244a1.75 1.75 0 0 1 1.006.319V11a1.5 1.5 0 0 0-1.5-1.5z"] %}
{% set icon_issue = ["M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z", "M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0zm0 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13z"] %}
{% set icon_repo = ["M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 0 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8zM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.25.25 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2z"] %}
{% set panel_height = 230 %}
{% if mission_stats %}
{% set metrics = [
  {"label": "Commits*", "value": mission_stats.commit_count, "paths": icon_commit, "color": theme.primary},
  {"label": "Stars", "value": mission_stats.star_count, "paths": icon_star, "color": theme.warning},
  {"label": "Pull Requests", "value": mission_stats.pull_request_count, "paths": icon_pr, "color": theme.success},
  {"label": "Issues", "value": mission_stats.issue_count, "paths": icon_issue, "color": theme.secondary},
  {"label": "Repositories", "value": mission_stats.repository_count, "paths": icon_repo, "color": theme.primary},
] %}
{% set cell_width = 1200 / metrics|length %}
{% endif %}
<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="{{ panel_height }}" viewBox="0 0 1280 {{ panel_height }}" role="img" aria-labelledby="mt-title mt-desc">
  <title id="mt-title">DSI — Mission Telemetry Console</title>
  <desc id="mt-desc">Métricas agregadas de atividade pública do operador no GitHub.</desc>
  <defs>
    <pattern id="mt-grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" fill="none" stroke="{{ theme.grid }}" stroke-width="1" opacity=".5"/></pattern>
    <filter id="mt-glow" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="3"/></filter>
  </defs>
  <rect width="1280" height="{{ panel_height }}" fill="{{ theme.background }}"/>
  <rect width="1280" height="{{ panel_height }}" fill="url(#mt-grid)" opacity=".5"/>
  <rect x="1" y="1" width="1278" height="{{ panel_height - 2 }}" fill="none" stroke="{{ theme.border }}" stroke-width="2"/>
  {% if enable_animations %}
  <rect x="0" y="-26" width="1280" height="26" fill="{{ theme.primary }}" opacity=".07">
    <animate attributeName="y" values="-26;{{ panel_height }}" dur="8s" repeatCount="indefinite"/>
  </rect>
  {% endif %}
  <g font-family="Consolas, 'Courier New', monospace">
    <text x="40" y="48" font-size="20" font-weight="700" letter-spacing="2" fill="{{ theme.text }}">MISSION TELEMETRY</text>
    <text x="40" y="70" font-size="12" letter-spacing="2" fill="{{ theme.muted }}">GITHUB ACTIVITY SNAPSHOT{% if enable_animations %}<tspan fill="{{ theme.primary }}"><animate attributeName="opacity" values="1;0;1" dur="1s" repeatCount="indefinite"/>_</tspan>{% endif %}</text>
    {% if mission_stats %}
    <circle cx="1152" cy="43" r="6" fill="{{ theme.success }}">{% if enable_animations %}<animate attributeName="opacity" values="1;.35;1" dur="2.8s" repeatCount="indefinite"/>{% endif %}</circle>
    <text x="1168" y="48" font-size="13" font-weight="700" letter-spacing="1" fill="{{ theme.primary }}">@{{ mission_stats.github_username }}</text>
    {% endif %}
  </g>
  <path d="M40 90H1240" stroke="{{ theme.primary }}" stroke-width="1" opacity=".45"/>
  {% if mission_stats %}
  {% for divider_index in range(1, metrics|length) %}
  <line x1="{{ 40 + cell_width * divider_index }}" y1="100" x2="{{ 40 + cell_width * divider_index }}" y2="196" stroke="{{ theme.border }}" stroke-width="1" opacity=".5"/>
  {% endfor %}
  <g font-family="Consolas, 'Courier New', monospace">
    {% for metric in metrics %}
    {% set cx = (40 + cell_width * loop.index0 + cell_width / 2) | round(1) %}
    <g>
      <g transform="translate({{ cx - 8 }} 100)" fill="{{ metric.color }}">
        {% for path in metric.paths %}<path d="{{ path }}">{% if enable_animations %}<animate attributeName="fill-opacity" values=".7;1;.7" dur="4s" begin="{{ (loop.index0 * 0.3) | round(2) }}s" repeatCount="indefinite"/>{% endif %}</path>{% endfor %}
      </g>
      <text x="{{ cx }}" y="162" text-anchor="middle" font-size="30" font-weight="700" font-family="'Segoe UI', sans-serif" fill="{{ metric.color }}" opacity=".35" filter="url(#mt-glow)">{{ metric.value }}</text>
      <text x="{{ cx }}" y="162" text-anchor="middle" font-size="30" font-weight="700" font-family="'Segoe UI', sans-serif" fill="{{ theme.text }}">{{ metric.value }}</text>
      <text x="{{ cx }}" y="184" text-anchor="middle" font-size="11" letter-spacing="1" fill="{{ theme.muted }}">{{ metric.label|upper }}</text>
    </g>
    {% endfor %}
  </g>
  <text x="40" y="216" font-family="Consolas, 'Courier New', monospace" font-size="10" fill="{{ theme.muted }}">* COMMIT COUNT VIA GITHUB SEARCH INDEX — APPROXIMATE, VERIFIED-EMAIL COMMITS ONLY</text>
  {% else %}
  <text x="40" y="150" font-family="Consolas, 'Courier New', monospace" font-size="14" fill="{{ theme.muted }}">NO TELEMETRY RECEIVED. RUN <tspan fill="{{ theme.primary }}">dsi-profile fetch-stats</tspan> TO ESTABLISH UPLINK.</text>
  {% endif %}
</svg>
