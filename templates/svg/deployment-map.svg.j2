<!-- DSI GitHub Command Center | Autor: Dayvid Santana | Criado/Editado: 28/08/2026 | Objetivo: Renderizar um mapa abstrato de implantação DSI. -->
<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="420" viewBox="0 0 1280 420" role="img" aria-labelledby="title description">
  <title id="title">DSI Deployment Map</title>
  <desc id="description">Mapa de nós de implantação para engenharia de software, inteligência artificial, dados e infraestrutura.</desc>
  <defs><pattern id="map-grid" width="32" height="32" patternUnits="userSpaceOnUse"><path d="M32 0H0V32" fill="none" stroke="{{ theme.grid }}" opacity=".55"/></pattern></defs>
  <rect width="1280" height="420" fill="{{ theme.background }}"/><rect width="1280" height="420" fill="url(#map-grid)"/>
  <text x="42" y="45" font-family="Consolas, 'Courier New', monospace" font-size="18" letter-spacing="2" fill="{{ theme.primary }}">DEPLOYMENT MAP // DSI-NET TOPOLOGY</text>
  <text x="42" y="70" font-family="Consolas, 'Courier New', monospace" font-size="12" letter-spacing="2" fill="{{ theme.muted }}">SECURE DEVELOPMENT NETWORK · NODE {{ profile.node }}</text>
  <g stroke="{{ theme.border }}" stroke-width="2" fill="none" opacity=".9">
    <path d="M330 215H555M725 215H950M640 130V95M640 300V335M330 215 150 120M330 215 150 310M950 215 1130 120M950 215 1130 310"/>
  </g>
  <g transform="translate(640 215)" font-family="Consolas, 'Courier New', monospace" text-anchor="middle">
    <circle r="85" fill="{{ theme.background_secondary }}" stroke="{{ theme.primary }}" stroke-width="3"/><circle r="54" fill="none" stroke="{{ theme.grid }}" stroke-width="2"/>
    <text y="-7" font-size="18" fill="{{ theme.text }}">DEV-01</text><text y="17" font-size="11" letter-spacing="2" fill="{{ theme.primary }}">COMMAND NODE</text>
    {% if enable_animations %}<circle r="72" fill="none" stroke="{{ theme.primary }}" opacity=".4"><animate attributeName="r" values="62;82;62" dur="4s" repeatCount="indefinite"/><animate attributeName="opacity" values=".55;0;.55" dur="4s" repeatCount="indefinite"/></circle>{% endif %}
  </g>
  {% set nodes = [(330, 215, 'SOFTWARE', 'ENGINEERING'), (150, 120, 'AI', 'SYSTEMS'), (150, 310, 'DATA', 'ENGINEERING'), (1130, 120, 'INFRA', 'STRUCTURE'), (1130, 310, 'AUTOMATION', 'OPS'), (640, 95, 'QUALITY', 'ASSURANCE'), (640, 335, 'RESEARCH', 'LAB')] %}
  {% for x, y, label, sublabel in nodes %}
  <g transform="translate({{ x }} {{ y }})" font-family="Consolas, 'Courier New', monospace" text-anchor="middle">
    <rect x="-76" y="-31" width="152" height="62" fill="{{ theme.background_secondary }}" stroke="{{ theme.border }}" stroke-width="2"/><path d="M-76-31H-48M76 31H48" stroke="{{ theme.primary }}" stroke-width="2"/>
    <circle cy="-11" r="4" fill="{{ theme.success }}">{% if enable_animations %}<animate attributeName="opacity" values="1;.3;1" dur="3s" begin="{{ loop.index0 * 0.25 }}s" repeatCount="indefinite"/>{% endif %}</circle>
    <text y="8" font-size="14" fill="{{ theme.text }}">{{ label }}</text><text y="23" font-size="10" letter-spacing="1" fill="{{ theme.muted }}">{{ sublabel }}</text>
  </g>
  {% endfor %}
</svg>
