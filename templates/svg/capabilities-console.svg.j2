<!-- DSI GitHub Command Center | Autor: Dayvid Santana | Criado/Editado: 28/08/2026 | Objetivo: Renderizar o console animado de capacidades técnicas. -->
{% set top_technologies = technologies[:12] %}
{% set more_count = (technologies|length - 12) if technologies|length > 12 else 0 %}
{% set row_height = 46 %}
{% set top_offset = 116 %}
{% set bottom_offset = 34 %}
{% set panel_height = top_offset + top_technologies|length * row_height + bottom_offset %}
{% set top_technology = (technologies|sort(attribute="level", reverse=True))|first %}
<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="{{ panel_height }}" viewBox="0 0 1280 {{ panel_height }}" role="img" aria-labelledby="cc-title cc-desc">
  <title id="cc-title">DSI — System Capabilities Console</title>
  <desc id="cc-desc">Matriz de prontidão técnica do operador, por tecnologia, status e nível declarado.</desc>
  <defs>
    <pattern id="cc-grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" fill="none" stroke="{{ theme.grid }}" stroke-width="1" opacity=".5"/></pattern>
  </defs>
  <rect width="1280" height="{{ panel_height }}" fill="{{ theme.background }}"/>
  <rect width="1280" height="{{ panel_height }}" fill="url(#cc-grid)" opacity=".5"/>
  <rect x="1" y="1" width="1278" height="{{ panel_height - 2 }}" fill="none" stroke="{{ theme.border }}" stroke-width="2"/>
  {% if enable_animations %}
  <rect x="0" y="-26" width="1280" height="26" fill="{{ theme.primary }}" opacity=".07">
    <animate attributeName="y" values="-26;{{ panel_height }}" dur="8s" repeatCount="indefinite"/>
  </rect>
  {% endif %}
  <g font-family="Consolas, 'Courier New', monospace">
    <text x="40" y="48" font-size="20" font-weight="700" letter-spacing="2" fill="{{ theme.text }}">SYSTEM CAPABILITIES</text>
    <text x="40" y="70" font-size="12" letter-spacing="2" fill="{{ theme.muted }}">READINESS MATRIX // {{ technologies|length }} SYSTEM{{ "S" if technologies|length != 1 else "" }} TRACKED{% if enable_animations %}<tspan fill="{{ theme.primary }}"><animate attributeName="opacity" values="1;0;1" dur="1s" repeatCount="indefinite"/>_</tspan>{% endif %}</text>
    <circle cx="1152" cy="43" r="6" fill="{{ theme.success }}">{% if enable_animations %}<animate attributeName="opacity" values="1;.35;1" dur="2.8s" repeatCount="indefinite"/>{% endif %}</circle>
    <text x="1168" y="48" font-size="13" font-weight="700" letter-spacing="1" fill="{{ theme.primary }}">CORE: {{ top_technology.name|upper }}</text>
  </g>
  <path d="M40 90H1240" stroke="{{ theme.primary }}" stroke-width="1" opacity=".45"/>
  <g font-family="Consolas, 'Courier New', monospace">
    {% for technology in top_technologies %}
    {% set row_y = top_offset + loop.index0 * row_height %}
    {% set status_upper = technology.status|upper %}
    {% set status_color = theme.success if ("OPERATIONAL" in status_upper or "ACTIVE" in status_upper or "ONLINE" in status_upper or "READY" in status_upper) else theme.warning if ("TRAINING" in status_upper or "STANDBY" in status_upper or "PENDING" in status_upper or "LEARNING" in status_upper) else theme.primary %}
    {% set fill_width = (430 * technology.level / 100) | round(1) %}
    <g>
      <title>{{ technology.name }} — {{ technology.category }} — {{ technology.status }} ({{ technology.level }}%)</title>
      <text x="40" y="{{ row_y + 5 }}" font-size="15" font-weight="600" fill="{{ theme.text }}">{{ technology.name }}<tspan font-size="12" fill="{{ theme.muted }}" dx="8">// {{ technology.category|upper }}</tspan></text>
      <rect x="380" y="{{ row_y - 7 }}" width="430" height="14" rx="3" fill="{{ theme.background_secondary }}" stroke="{{ theme.border }}" stroke-width="1"/>
      <rect x="380" y="{{ row_y - 7 }}" height="14" rx="3" fill="{{ status_color }}" width="{{ fill_width if not enable_animations else 0 }}">
        {% if enable_animations %}<animate attributeName="width" from="0" to="{{ fill_width }}" dur="1s" begin="{{ (loop.index0 * 0.1) | round(2) }}s" fill="freeze"/>{% endif %}
      </rect>
      <text x="822" y="{{ row_y + 5 }}" font-size="13" fill="{{ theme.text }}">{{ technology.level }}%</text>
      <rect x="870" y="{{ row_y - 8 }}" width="130" height="20" rx="3" fill="none" stroke="{{ status_color }}" stroke-width="1.5"/>
      <text x="935" y="{{ row_y + 5 }}" font-size="10" letter-spacing="1" fill="{{ status_color }}" text-anchor="middle">{{ technology.status|upper }}</text>
    </g>
    {% endfor %}
  </g>
  {% if more_count > 0 %}
  <text x="40" y="{{ panel_height - 14 }}" font-family="Consolas, 'Courier New', monospace" font-size="11" letter-spacing="1" fill="{{ theme.muted }}">+{{ more_count }} ADDITIONAL SYSTEM{{ "S" if more_count != 1 else "" }} LOGGED</text>
  {% endif %}
</svg>
