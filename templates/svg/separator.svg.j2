<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="70" viewBox="0 0 1280 70" role="img" aria-label="{{ index }} // {{ title }}">
  <rect width="1280" height="70" fill="{{ theme.background }}"/>
  <path d="M0 35H50M420 35H1280" stroke="{{ theme.border }}" stroke-width="2"/>
  <path d="M50 35H420" stroke="{{ theme.primary }}" stroke-width="2"/>
  <rect x="68" y="17" width="44" height="36" fill="{{ theme.primary }}"/><text x="79" y="41" font-family="Consolas, 'Courier New', monospace" font-size="16" font-weight="700" fill="{{ theme.background }}">{{ index }}</text>
  <text x="132" y="33" font-family="Consolas, 'Courier New', monospace" font-size="18" font-weight="700" letter-spacing="1" fill="{{ theme.text }}">{{ title }}</text>
  <text x="132" y="51" font-family="Consolas, 'Courier New', monospace" font-size="11" letter-spacing="2" fill="{{ theme.muted }}">{{ code }}</text>
</svg>
